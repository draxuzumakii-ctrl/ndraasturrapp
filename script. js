// --- Toast Helper ---
function showToast(msg, type = 'success') {
  const bg = type === 'error' ? 'rgba(239,68,68,0.9)' : type === 'warning' ? 'rgba(245,158,11,0.9)' : 'rgba(34,197,94,0.9)';
  if (typeof Toastify !== 'undefined') {
    Toastify({
      text: msg,
      duration: 3000,
      gravity: 'top',
      position: 'center',
      className: 'glass-toast',
      style: { background: bg, borderRadius: '16px', padding: '14px 20px', fontWeight: '600' },
      stopOnFocus: true
    }).showToast();
  }
}

// --- Auth Check ---
auth.onAuthStateChanged(async (user) => {
  if (!user) {
    // Redirect ke login jika bukan di halaman login
    if (!window.location.pathname.includes('index.html')) {
      window.location.href = 'index.html';
    }
    return;
  }

  currentUser = user;
  console.log('✅ User logged in:', user.uid);

  // Setup UI
  setupNavigation();
  setupUserUI();

  // Load data sesuai halaman
  const path = window.location.pathname;
  if (path.includes('beranda.html')) {
    await loadDashboard();
  } else if (path.includes('akun.html')) {
    await loadAccountsPage();
  } else if (path.includes('catatan.html')) {
    await loadNotesPage();
  }
});

// --- Setup Navigation ---
function setupNavigation() {
  // Mobile menu toggle
  const menuToggle = document.getElementById('menuToggle');
  const sidebar = document.getElementById('sidebar');
  const sidebarOverlay = document.getElementById('sidebarOverlay');
  const mainContent = document.getElementById('mainContent');

  if (menuToggle && sidebar && sidebarOverlay) {
    // Show menu button on mobile
    const checkMobile = () => {
      if (window.innerWidth <= 768) {
        menuToggle.style.display = 'flex';
        sidebar.classList.add('collapsed');
      } else {
        menuToggle.style.display = 'none';
        sidebar.classList.remove('collapsed');
        sidebar.classList.remove('open');
        sidebarOverlay.classList.remove('active');
      }
    };

    checkMobile();
    window.addEventListener('resize', checkMobile);

    menuToggle.addEventListener('click', () => {
      sidebar.classList.toggle('open');
      sidebarOverlay.classList.toggle('active');
    });

    sidebarOverlay.addEventListener('click', () => {
      sidebar.classList.remove('open');
      sidebarOverlay.classList.remove('active');
    });
  }

  // Logout
  const logoutBtn = document.getElementById('logoutBtn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async (e) => {
      e.preventDefault();
      const result = await Swal.fire({
        title: 'Logout?',
        text: 'Anda akan keluar dari aplikasi.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Ya, Logout',
        cancelButtonText: 'Batal',
        background: 'rgba(20,20,45,0.95)',
        color: '#f1f5f9',
        backdrop: 'rgba(0,0,0,0.6)',
        confirmButtonColor: '#8b5cf6',
        cancelButtonColor: '#475569'
      });
      if (result.isConfirmed) {
        await auth.signOut();
        window.location.href = 'index.html';
      }
    });
  }
}

