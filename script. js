async function loadAccountsPage() {
  if (!currentUser) return;

  const uid = currentUser.uid;

  try {
    const snap = await db.collection('users').doc(uid).collection('accounts').orderBy('createdAt', 'desc').get();
    allAccounts = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    renderAccountCards();

    // Setup listeners
    setupAccountListeners();
  } catch (err) {
    console.error('Error loading accounts:', err);
    showToast('Gagal memuat akun', 'error');
  }
}

function getRemainingDays(account) {
  if (!account.tanggalBind || !account.durasiBind) return 999;
  const bindDate = account.tanggalBind.toDate ? account.tanggalBind.toDate() : new Date(account.tanggalBind);
  const unbindDate = new Date(bindDate);
  unbindDate.setDate(unbindDate.getDate() + parseInt(account.durasiBind));
  const now = new Date();
  const diff = Math.ceil((unbindDate - now) / (1000 * 60 * 60 * 24));
  return Math.max(0, diff);
}

function getCountdownStatus(account) {
  const days = getRemainingDays(account);
  if (days <= 0) return 'ready';
  if (days <= 1) return '1hari';
  if (days <= 3) return '3hari';
  if (days <= 7) return '7hari';
  return 'bind';
}

function getStatusBadge(account) {
  const status = getCountdownStatus(account);
  const map = {
    'ready': { class: 'countdown-success', text: '🟢 READY UNBIND' },
    '1hari': { class: 'countdown-danger', text: '🔵 1 Hari Lagi' },
    '3hari': { class: 'countdown-warning', text: '🟠 3 Hari Lagi' },
    '7hari': { class: 'countdown-info', text: '🟡 7 Hari Lagi' },
    'bind': { class: 'countdown-danger', text: '🔴 Masih Bind' },
  };
  return map[status] || map['bind'];
}

function getGameBadgeClass(game) {
  const map = {
    'Free Fire': 'badge-ff', 'MLBB': 'badge-mlbb', 'PUBG': 'badge-pubg',
    'CODM': 'badge-codm', 'Roblox': 'badge-roblox', 'Honor Of Kings': 'badge-hok',
    'Arena Breakout': 'badge-ab', 'Blood Strike': 'badge-bs', 'Delta Force': 'badge-df'
  };
  return map[game] || 'badge-other';
}

function getLabelClass(label) {
  const map = { 'Ready': 'label-ready', 'Sold': 'label-sold', 'Pribadi': 'label-pribadi', 'Dipakai': 'label-dipakai', 'Dijual': 'label-dijual' };
  return map[label] || '';
}

function renderAccountCards(filteredAccounts = null) {
  const grid = document.getElementById('accountGrid');
  const emptyState = document.getElementById('emptyState');
  const calendarView = document.getElementById('calendarView');

  if (!grid) return;

  let accounts = filteredAccounts || allAccounts;

  // Apply filters
  const searchTerm = document.getElementById('searchInput')?.value?.toLowerCase() || '';
  const filterGame = document.getElementById('filterGame')?.value || '';
  const filterStatus = document.getElementById('filterStatus')?.value || '';
  const filterLabel = document.getElementById('filterLabel')?.value || '';
  const sortBy = document.getElementById('sortBy')?.value || 'newest';

  if (searchTerm) {
    accounts = accounts.filter(a =>
      (a.gmail || '').toLowerCase().includes(searchTerm) ||
      (a.uid || '').toLowerCase().includes(searchTerm) ||
      (a.nickname || '').toLowerCase().includes(searchTerm)
    );
  }
  if (filterGame) accounts = accounts.filter(a => a.game === filterGame);
  if (filterStatus === 'ready') accounts = accounts.filter(a => getCountdownStatus(a) === 'ready');
  if (filterStatus === 'bind') accounts = accounts.filter(a => getCountdownStatus(a) !== 'ready');
  if (filterLabel) accounts = accounts.filter(a => a.label === filterLabel);

  // Sort
  if (sortBy === 'newest') accounts.sort((a, b) => (b.createdAt?.toDate?.() || 0) - (a.createdAt?.toDate?.() || 0));
  if (sortBy === 'oldest') accounts.sort((a, b) => (a.createdAt?.toDate?.() || 0) - (b.createdAt?.toDate?.() || 0));
  if (sortBy === 'countdown') accounts.sort((a, b) => getRemainingDays(a) - getRemainingDays(b));
  if (sortBy === 'name') accounts.sort((a, b) => (a.game || '').localeCompare(b.game || ''));

  if (accounts.length === 0) {
    grid.innerHTML = '';
    if (emptyState) emptyState.classList.remove('hidden');
    if (calendarView) calendarView.classList.add('hidden');
    return;
  }

  if (emptyState) emptyState.classList.add('hidden');

  grid.innerHTML = accounts.map(account => {
    const days = getRemainingDays(account);
    const statusBadge = getStatusBadge(account);
    const gameClass = getGameBadgeClass(account.game);
    const labelClass = getLabelClass(account.label);

    return `
      <div class="account-card animate-in" data-id="${account.id}">
        <div class="flex items-center justify-between mb-2">
          <span class="game-badge ${gameClass}">🎮 ${account.game || 'Unknown'}</span>
          ${account.label ? `<span class="label-badge ${labelClass}">${account.label}</span>` : ''}
        </div>
        <div class="account-info">
          <div class="info-item"><span class="info-label">Gmail</span><span class="info-value">${account.gmail || '-'}</span></div>
          <div class="info-item"><span class="info-label">Password</span><span class="info-value pw-hidden" onclick="togglePW(this)">${account.password || '-'}</span></div>
          <div class="info-item"><span class="info-label">UID</span><span class="info-value">${account.uid || '-'}</span></div>
          <div class="info-item"><span class="info-label">Nickname</span><span class="info-value">${account.nickname || '-'}</span></div>
          <div class="info-item"><span class="info-label">Server</span><span class="info-value">${account.server || '-'}</span></div>
          <div class="info-item"><span class="info-label">Bind</span><span class="info-value">${account.bind || '-'}</span></div>
          <div class="info-item"><span class="info-label">Tgl Bind</span><span class="info-value">${formatDate(account.tanggalBind)}</span></div>
          <div class="info-item"><span class="info-label">Durasi</span><span class="info-value">${account.durasiBind || '-'} hari</span></div>
        </div>
        <span class="countdown-badge ${statusBadge.class}">${statusBadge.text} (${days} hari)</span>
        ${account.catatan ? `<p class="text-sm text-muted mt-2">📝 ${account.catatan}</p>` : ''}
        <div class="card-actions">
          <button class="btn btn-secondary btn-sm" onclick="copyField('${escapeStr(account.gmail || '')}', 'Gmail')">📋 Gmail</button>
          <button class="btn btn-secondary btn-sm" onclick="copyField('${escapeStr(account.password || '')}', 'Password')">🔑 PW</button>
          <button class="btn btn-secondary btn-sm" onclick="copyAll('${escapeStr(account.gmail || '')}', '${escapeStr(account.password || '')}')">📋✉️</button>
          <button class="btn btn-secondary btn-sm" onclick="copyFullData('${account.id}')">📋 Semua</button>
          <button class="btn btn-ghost btn-sm" onclick="editAccount('${account.id}')">✏️</button>
          <button class="btn btn-ghost btn-sm" style="color:#ef4444;" onclick="deleteAccount('${account.id}')">🗑️</button>
        </div>
      </div>
    `;
  }).join('');
}

function escapeStr(str) {
  return (str || '').replace(/'/g, "\\'").replace(/"/g, '\\"').replace(/`/g, '\\`');
}

function togglePW(el) {
  el.classList.toggle('pw-visible');
  el.classList.toggle('pw-hidden');
}

function copyField(value, label) {
  if (!value) { showToast('Data kosong', 'warning'); return; }
  navigator.clipboard.writeText(value).then(() => showToast(`${label} disalin!`)).catch(() => showToast('Gagal menyalin', 'error'));
}

function copyAll(gmail, password) {
  const text = `Gmail: ${gmail}\nPassword: ${password}`;
  navigator.clipboard.writeText(text).then(() => showToast('Gmail + Password disalin!')).catch(() => showToast('Gagal menyalin', 'error'));
}

function copyFullData(accountId) {
  const acc = allAccounts.find(a => a.id === accountId);
  if (!acc) return;
  const text = `Game: ${acc.game}\nGmail: ${acc.gmail}\nPassword: ${acc.password}\nUID: ${acc.uid}\nNickname: ${acc.nickname}\nServer: ${acc.server}\nBind: ${acc.bind}\nTgl Bind: ${formatDate(acc.tanggalBind)}\nDurasi: ${acc.durasiBind} hari\nStatus: ${getCountdownStatus(acc)}\nLabel: ${acc.label}\nCatatan: ${acc.catatan}`;
  navigator.clipboard.writeText(text).then(() => showToast('Semua data disalin!')).catch(() => showToast('Gagal menyalin', 'error'));
}

function formatDate(dateVal) {
  if (!dateVal) return '-';
  const d = dateVal.toDate ? dateVal.toDate() : new Date(dateVal);
  return d.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
}

function formatRupiah(val) {
  if (val === 0) return 'Rp0';
  if (!val) return '-';
  const abs = Math.abs(val);
  const formatted = abs.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  return val < 0 ? `-Rp${formatted}` : `Rp${formatted}`;
}

function setupAccountListeners() {
  // Search & Filter
  ['searchInput', 'filterGame', 'filterStatus', 'filterLabel', 'sortBy'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('input', () => renderAccountCards());
  });

  // Add button
  const addBtn = document.getElementById('addAccountBtn');
  const emptyAddBtn = document.getElementById('emptyAddBtn');
  if (addBtn) addBtn.addEventListener('click', () => openAccountModal());
  if (emptyAddBtn) emptyAddBtn.addEventListener('click', () => openAccountModal());

  // Modal
  const modal = document.getElementById('accountModal');
  const closeModal = document.getElementById('closeModal');
  const cancelModal = document.getElementById('cancelModal');
  const saveBtn = document.getElementById('saveAccount');

  if (closeModal) closeModal.addEventListener('click', () => modal.classList.add('hidden'));
  if (cancelModal) cancelModal.addEventListener('click', () => modal.classList.add('hidden'));
  if (saveBtn) saveBtn.addEventListener('click', saveAccount);

  // Close modal on overlay click
  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.add('hidden');
    });
  }

  // Tabs
  const tabBtns = document.querySelectorAll('#viewTabs .tab-btn');
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const view = btn.dataset.view;
      if (view === 'calendar') {
        document.getElementById('accountGrid').classList.add('hidden');
        document.getElementById('calendarView').classList.remove('hidden');
        renderCalendar();
      } else {
        document.getElementById('accountGrid').classList.remove('hidden');
        document.getElementById('calendarView').classList.add('hidden');
      }
    });
  });

  // Calendar navigation
  const prevMonth = document.getElementById('prevMonth');
  const nextMonth = document.getElementById('nextMonth');
  if (prevMonth) prevMonth.addEventListener('click', () => { calendarDate.setMonth(calendarDate.getMonth() - 1); renderCalendar(); });
  if (nextMonth) nextMonth.addEventListener('click', () => { calendarDate.setMonth(calendarDate.getMonth() + 1); renderCalendar(); });

  // Check URL param for quick add
  const params = new URLSearchParams(window.location.search);
  if (params.get('action') === 'add') {
    openAccountModal();
    window.history.replaceState({}, '', 'akun.html');
  }
}

function openAccountModal(accountId = null) {
  editingAccountId = accountId;
  const modal = document.getElementById('accountModal');
  const title = document.getElementById('modalTitle');
  const body = document.getElementById('accountFormBody');

  if (!modal || !body) return;

  let account = {};
  if (accountId) {
    account = allAccounts.find(a => a.id === accountId) || {};
    title.textContent = 'Edit Akun';
  } else {
    title.textContent = 'Tambah Akun';
  }

  const games = ['Free Fire', 'MLBB', 'PUBG', 'CODM', 'Roblox', 'Honor Of Kings', 'Arena Breakout', 'Blood Strike', 'Delta Force', 'Lainnya'];
  const binds = ['Google', 'Facebook', 'VK', 'Apple', 'Twitter/X', 'Garena', 'Moonton', 'Lainnya'];
  const durasiOptions = ['7', '14', '30', '60', '90'];
  const labels = ['Ready', 'Sold', 'Pribadi', 'Dipakai', 'Dijual'];

  body.innerHTML = `
    <label>Game</label>
    <select class="glass-select" id="formGame">${games.map(g => `<option value="${g}" ${account.game === g ? 'selected' : ''}>${g}</option>`).join('')}</select>

    <label>Bind</label>
    <select class="glass-select" id="formBind">${binds.map(b => `<option value="${b}" ${account.bind === b ? 'selected' : ''}>${b}</option>`).join('')}</select>

    <label>Gmail</label>
    <input class="glass-input" id="formGmail" value="${account.gmail || ''}" placeholder="email@gmail.com">

    <label>Password</label>
    <input class="glass-input" id="formPassword" value="${account.password || ''}" placeholder="Password akun">

    <label>UID / ID Game</label>
    <input class="glass-input" id="formUID" value="${account.uid || ''}" placeholder="123456789">

    <label>Nickname</label>
    <input class="glass-input" id="formNickname" value="${account.nickname || ''}" placeholder="Nama in-game">

    <label>Server</label>
    <input class="glass-input" id="formServer" value="${account.server || ''}" placeholder="Server (opsional)">

    <label>Tanggal Bind</label>
    <input type="date" class="glass-input" id="formTanggalBind" value="${account.tanggalBind ? formatDateInput(account.tanggalBind) : ''}">

    <label>Durasi Bind</label>
    <select class="glass-select" id="formDurasi">
      ${durasiOptions.map(d => `<option value="${d}" ${account.durasiBind == d ? 'selected' : ''}>${d} Hari</option>`).join('')}
      <option value="custom" ${account.durasiBind && !durasiOptions.includes(String(account.durasiBind)) ? 'selected' : ''}>Custom</option>
    </select>
    <input class="glass-input hidden" id="formDurasiCustom" value="${account.durasiBind && !durasiOptions.includes(String(account.durasiBind)) ? account.durasiBind : ''}" placeholder="Jumlah hari" type="number">

    <label>Label</label>
    <select class="glass-select" id="formLabel">
      <option value="">-</option>
      ${labels.map(l => `<option value="${l}" ${account.label === l ? 'selected' : ''}>${l}</option>`).join('')}
    </select>

    <label>Status</label>
    <select class="glass-select" id="formStatus">
      <option value="Aktif" ${account.status === 'Aktif' || !account.status ? 'selected' : ''}>Aktif</option>
      <option value="Nonaktif" ${account.status === 'Nonaktif' ? 'selected' : ''}>Nonaktif</option>
    </select>

    <label>Catatan</label>
    <textarea class="glass-input" id="formCatatan" rows="2" placeholder="Catatan tambahan...">${account.catatan || ''}</textarea>
  `;

  // Custom durasi toggle
  const durasiSelect = document.getElementById('formDurasi');
  const durasiCustom = document.getElementById('formDurasiCustom');
  if (durasiSelect && durasiCustom) {
    durasiSelect.addEventListener('change', () => {
      durasiCustom.classList.toggle('hidden', durasiSelect.value !== 'custom');
    });
    if (durasiSelect.value === 'custom') durasiCustom.classList.remove('hidden');
  }

  modal.classList.remove('hidden');
}

function formatDateInput(dateVal) {
  if (!dateVal) return '';
  const d = dateVal.toDate ? dateVal.toDate() : new Date(dateVal);
  return d.toISOString().split('T')[0];
}

async function saveAccount() {
  if (!currentUser) return;

  const uid = currentUser.uid;
  const game = document.getElementById('formGame')?.value || '';
  const bind = document.getElementById('formBind')?.value || '';
  const gmail = document.getElementById('formGmail')?.value || '';
  const password = document.getElementById('formPassword')?.value || '';
  const uidGame = document.getElementById('formUID')?.value || '';
  const nickname = document.getElementById('formNickname')?.value || '';
  const server = document.getElementById('formServer')?.value || '';
  const tanggalBind = document.getElementById('formTanggalBind')?.value || '';
  const durasiSelect = document.getElementById('formDurasi')?.value || '30';
  const durasiCustom = document.getElementById('formDurasiCustom')?.value || '';
  const durasi = durasiSelect === 'custom' ? parseInt(durasiCustom) || 30 : parseInt(durasiSelect);
  const label = document.getElementById('formLabel')?.value || '';
  const status = document.getElementById('formStatus')?.value || 'Aktif';
  const catatan = document.getElementById('formCatatan')?.value || '';

  if (!game || !gmail) {
    showToast('Game dan Gmail wajib diisi!', 'warning');
