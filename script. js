// --- Calendar ---
function renderCalendar() {
  const title = document.getElementById('calendarMonthTitle');
  const grid = document.getElementById('calendarGrid');
  const detail = document.getElementById('calendarDayDetail');
  if (!title || !grid) return;

  const year = calendarDate.getFullYear();
  const month = calendarDate.getMonth();

  title.textContent = new Date(year, month).toLocaleString('id-ID', { month: 'long', year: 'numeric' });

  const firstDay = new Date(year, month, 1).getDay();
  const daysInMonth = new Date(year, month + 1, 0).getDate();

  // Ready dates map
  const readyDates = {};
  allAccounts.forEach(a => {
    if (getCountdownStatus(a) === 'ready' && a.tanggalBind) {
      const d = a.tanggalBind.toDate ? a.tanggalBind.toDate() : new Date(a.tanggalBind);
      const unbind = new Date(d);
      unbind.setDate(unbind.getDate() + (a.durasiBind || 0));
      const key = `${unbind.getFullYear()}-${unbind.getMonth()}-${unbind.getDate()}`;
      if (!readyDates[key]) readyDates[key] = [];
      readyDates[key].push(a);
    }
  });

  let html = '';
  // Day headers
  ['Min', 'Sen', 'Sel', 'Rab', 'Kam', 'Jum', 'Sab'].forEach(d => {
    html += `<div style="text-align:center;font-weight:700;font-size:0.75rem;color:var(--text-muted);padding:8px 0;">${d}</div>`;
  });

  // Empty cells
  for (let i = 0; i < firstDay; i++) {
    html += '<div></div>';
  }

  const today = new Date();
  for (let day = 1; day <= daysInMonth; day++) {
    const dateKey = `${year}-${month}-${day}`;
    const isToday = today.getFullYear() === year && today.getMonth() === month && today.getDate() === day;
    const hasReady = readyDates[dateKey] && readyDates[dateKey].length > 0;
    const cls = `calendar-day${isToday ? ' today' : ''}${hasReady ? ' has-ready' : ''}`;

    html += `<div class="${cls}" data-date="${dateKey}" onclick="showCalendarDay('${dateKey}')">${day}</div>`;
  }

  grid.innerHTML = html;

  if (detail) detail.innerHTML = '';
}

function showCalendarDay(dateKey) {
  const detail = document.getElementById('calendarDayDetail');
  if (!detail) return;

  const [y, m, d] = dateKey.split('-').map(Number);
  const readyAccounts = allAccounts.filter(a => {
    if (getCountdownStatus(a) !== 'ready' || !a.tanggalBind) return false;
    const bd = a.tanggalBind.toDate ? a.tanggalBind.toDate() : new Date(a.tanggalBind);
    const ub = new Date(bd);
    ub.setDate(ub.getDate() + (a.durasiBind || 0));
    return ub.getFullYear() === y && ub.getMonth() === m && ub.getDate() === d;
  });

  if (readyAccounts.length === 0) {
    detail.innerHTML = `<p class="text-muted">Tidak ada akun ready unbind di tanggal ini.</p>`;
    return;
  }

  detail.innerHTML = `
    <h3 style="margin-bottom:12px;">🟢 Ready Unbind — ${d}/${m+1}/${y}</h3>
    <div class="account-grid">
      ${readyAccounts.map(a => {
        const gameClass = getGameBadgeClass(a.game);
        return `
          <div class="account-card">
            <span class="game-badge ${gameClass}">🎮 ${a.game || 'Unknown'}</span>
            <div class="account-info">
              <div class="info-item"><span class="info-label">Gmail</span><span class="info-value">${a.gmail || '-'}</span></div>
              <div class="info-item"><span class="info-label">UID</span><span class="info-value">${a.uid || '-'}</span></div>
              <div class="info-item"><span class="info-label">Nickname</span><span class="info-value">${a.nickname || '-'}</span></div>
            </div>
            <span class="countdown-badge countdown-success">🟢 READY UNBIND</span>
            <div class="card-actions mt-2">
              <button class="btn btn-secondary btn-sm" onclick="copyField('${escapeStr(a.gmail || '')}', 'Gmail')">📋 Gmail</button>
              <button class="btn btn-secondary btn-sm" onclick="copyField('${escapeStr(a.password || '')}', 'Password')">🔑 PW</button>
            </div>
          </div>
        `;
      }).join('')}
    </div>
  `;
}

