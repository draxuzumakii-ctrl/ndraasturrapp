    durasiBind: durasi,
    label, status, catatan,
    updatedAt: firebase.firestore.FieldValue.serverTimestamp()
  };

  try {
    if (editingAccountId) {
      await db.collection('users').doc(uid).collection('accounts').doc(editingAccountId).update(data);
      showToast('Akun berhasil diupdate! ✅');
    } else {
