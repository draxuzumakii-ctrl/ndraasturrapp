// ============================================
// DASHBOARD (beranda.html)
// ============================================
async function loadDashboard() {
  if (!currentUser) return;

  const uid = currentUser.uid;
  const statsGrid = document.getElementById('statsGrid');

  try {
    // Fetch accounts
    const accountsSnap = await db.collection('users').doc(uid).collection('accounts').get();
    allAccounts = accountsSnap.docs.map(d => ({ id: d.id, ...d.data() }));

    // Fetch transactions
    const transSnap = await db.collection('users').doc(uid).collection('transactions').get();
    allTransactions = transSnap.docs.map(d => ({ id: d.id, ...d.data() }));

    // Calculate stats
    const totalAkun = allAccounts.length;
    const readyUnbind = allAccounts.filter(a => getCountdownStatus(a) === 'ready').length;
    const masihBind = totalAkun - readyUnbind;

    // Countdown terdekat
    const sortedByCountdown = [...allAccounts]
      .filter(a => getCountdownStatus(a) !== 'ready')
      .sort((a, b) => getRemainingDays(a) - getRemainingDays(b));
    const nearestCountdown = sortedByCountdown.length > 0 ? getRemainingDays(sortedByCountdown[0]) : '-';

    // Game totals
    const gameCounts = {};
    allAccounts.forEach(a => {
      const g = a.game || 'Lainnya';
      gameCounts[g] = (gameCounts[g] || 0) + 1;
    });

    // Transaction stats
    const penjualan = allTransactions.filter(t => t.kategori === 'Penjualan' && t.status === 'Selesai').reduce((s, t) => s + (parseFloat(t.nominal) || 0), 0);
    const mc = allTransactions.filter(t => t.kategori === 'MC' && t.status === 'Selesai').reduce((s, t) => s + (parseFloat(t.nominal) || 0), 0);
    const jasaAdmin = allTransactions.filter(t => t.kategori === 'Jasa Admin' && t.status === 'Selesai').reduce((s, t) => s + (parseFloat(t.nominal) || 0), 0);
    const pemasukan = allTransactions.filter(t => ['Penjualan', 'MC', 'Jasa Admin', 'Pemasukan'].includes(t.kategori) && t.status === 'Selesai').reduce((s, t) => s + (parseFloat(t.nominal) || 0), 0);
    const pengeluaran = allTransactions.filter(t => ['Pengeluaran', 'Pembelian'].includes(t.kategori) && t.status === 'Selesai').reduce((s, t) => s + (parseFloat(t.nominal) || 0), 0);
    const profit = pemasukan - pengeluaran;

    // Render stats
    const statsData = [
      { icon: '🔐', value: totalAkun, label: 'Total Akun' },
      { icon: '🟢', value: readyUnbind, label: 'Ready Unbind' },
      { icon: '🔴', value: masihBind, label: 'Masih Bind' },
      { icon: '⏳', value: nearestCountdown + ' hari', label: 'Countdown Terdekat' },
      { icon: '🔥', value: gameCounts['Free Fire'] || 0, label: 'Free Fire' },
      { icon: '👑', value: gameCounts['MLBB'] || 0, label: 'MLBB' },
      { icon: '🎯', value: gameCounts['PUBG'] || 0, label: 'PUBG' },
      { icon: '🎮', value: gameCounts['Roblox'] || 0, label: 'Roblox' },
      { icon: '💰', value: formatRupiah(penjualan), label: 'Total Penjualan' },
      { icon: '💎', value: formatRupiah(mc), label: 'Total MC' },
      { icon: '🛠️', value: formatRupiah(jasaAdmin), label: 'Jasa Admin' },
      { icon: '📈', value: formatRupiah(profit), label: 'Total Profit' },
    ];

    if (statsGrid) {
      statsGrid.innerHTML = statsData.map(s => `
        <div class="stat-card animate-in">
          <div class="stat-icon">${s.icon}</div>
          <div class="stat-value">${s.value}</div>
          <div class="stat-label">${s.label}</div>
        </div>
      `).join('');
    }

    // Render charts
    renderGameChart(gameCounts);
    renderProfitChart();

    // Upcoming countdowns
    const upcomingDiv = document.getElementById('upcomingCountdowns');
    if (upcomingDiv) {
      const upcoming = sortedByCountdown.slice(0, 5);
      if (upcoming.length === 0) {
        upcomingDiv.innerHTML = '<p class="text-muted">Tidak ada countdown aktif</p>';
      } else {
        upcomingDiv.innerHTML = upcoming.map(a => {
          const days = getRemainingDays(a);
          const statusClass = days <= 1 ? 'countdown-danger' : days <= 3 ? 'countdown-warning' : days <= 7 ? 'countdown-info' : 'countdown-success';
          return `
            <div class="glass-xs" style="padding:12px 16px;min-width:180px;">
              <strong>${a.game || 'Unknown'}</strong>
              <span class="countdown-badge ${statusClass}" style="display:block;margin-top:6px;">${days} hari lagi</span>
              <small class="text-muted">${a.nickname || a.gmail || '-'}</small>
            </div>
          `;
        }).join('');
      }
    }

    // Refresh button
    const refreshBtn = document.getElementById('refreshBtn');
    if (refreshBtn) {
      refreshBtn.addEventListener('click', () => loadDashboard());
    }

    // Backup button
    const backupBtn = document.getElementById('backupBtn');
    if (backupBtn) {
      backupBtn.addEventListener('click', backupData);
    }

  } catch (err) {
    console.error('Error loading dashboard:', err);
    showToast('Gagal memuat dashboard', 'error');
  }
}

function renderGameChart(gameCounts) {
  const ctx = document.getElementById('chartGame');
  if (!ctx) return;

  if (charts.game) charts.game.destroy();

  const labels = Object.keys(gameCounts);
  const data = Object.values(gameCounts);
  const colors = ['#ff6b35', '#00a3ff', '#f0b428', '#ff5032', '#ccc', '#dc283c', '#b48c64', '#ff3c50', '#64b478', '#a08cdc'];

  charts.game = new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: labels,
      datasets: [{
        data: data,
        backgroundColor: colors.slice(0, labels.length),
        borderColor: 'rgba(0,0,0,0.3)',
        borderWidth: 2,
        hoverBorderColor: '#fff',
        hoverBorderWidth: 3
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      plugins: {
        legend: {
          position: 'bottom',
          labels: { color: '#94a3b8', padding: 16, font: { size: 11 } }
        }
      }
    }
  });
}

function renderProfitChart() {
  const ctx = document.getElementById('chartProfit');
  if (!ctx) return;

  if (charts.profit) charts.profit.destroy();

  // Group by month
  const monthly = {};
  allTransactions.forEach(t => {
    if (t.tanggal && t.status === 'Selesai') {
      const d = t.tanggal.toDate ? t.tanggal.toDate() : new Date(t.tanggal);
      const key = d.toLocaleString('id-ID', { month: 'short', year: 'numeric' });
      const val = parseFloat(t.nominal) || 0;
      if (['Penjualan', 'MC', 'Jasa Admin', 'Pemasukan'].includes(t.kategori)) {
        monthly[key] = (monthly[key] || 0) + val;
      } else if (['Pengeluaran', 'Pembelian'].includes(t.kategori)) {
        monthly[key] = (monthly[key] || 0) - val;
      }
    }
  });

  const labels = Object.keys(monthly).slice(-6);
  const data = labels.map(l => monthly[l]);

  charts.profit = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: labels,
      datasets: [{
        label: 'Profit',
        data: data,
        backgroundColor: data.map(v => v >= 0 ? 'rgba(139,92,246,0.5)' : 'rgba(239,68,68,0.5)'),
        borderColor: data.map(v => v >= 0 ? '#8b5cf6' : '#ef4444'),
        borderWidth: 2,
        borderRadius: 8,
        borderSkipped: false
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: true,
      plugins: {
        legend: { display: false }
      },
      scales: {
        x: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
        y: { ticks: { color: '#94a3b8', callback: v => formatRupiah(v) }, grid: { color: 'rgba(255,255,255,0.05)' } }
      }
    }
  });
}

