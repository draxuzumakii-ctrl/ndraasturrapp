async function loadNotesPage() {
  if (!currentUser) return;

  const uid = currentUser.uid;

  try {
    const snap = await db.collection('users').doc(uid).collection('transactions').orderBy('createdAt', 'desc').get();
    allTransactions = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    renderNotes();
    renderRekap();
    renderBulananChart();
    setupNoteListeners();

    const params = new URLSearchParams(window.location.search);
    if (params.get('action') === 'add') {
      openNoteModal();
      window.history.replaceState({}, '', 'catatan.html');
    }
  } catch (err) {
    console.error('Error loading notes:', err);
    showToast('Gagal memuat catatan', 'error');
  }
}

function renderRekap() {
  const grid = document.getElementById('rekapsGrid');
  if (!grid) return;

  const penjualan = allTransactions.filter(t => t.kategori === 'Penjualan' && t.status === 'Selesai').reduce((s, t) => s + (parseFloat(t.nominal) || 0), 0);
  const mc = allTransactions.filter(t => t.kategori === 'MC' && t.status === 'Selesai').reduce((s, t) => s + (parseFloat(t.nominal) || 0), 0);
  const jasa = allTransactions.filter(t => t.kategori === 'Jasa Admin' && t.status === 'Selesai').reduce((s, t) => s + (parseFloat(t.nominal) || 0), 0);
  const pemasukan = allTransactions.filter(t => ['Penjualan', 'MC', 'Jasa Admin', 'Pemasukan'].includes(t.kategori) && t.status === 'Selesai').reduce((s, t) => s + (parseFloat(t.nominal) || 0), 0);
  const pengeluaran = allTransactions.filter(t => ['Pengeluaran', 'Pembelian'].includes(t.kategori) && t.status === 'Selesai').reduce((s, t) => s + (parseFloat(t.nominal) || 0), 0);
  const profit = pemasukan - pengeluaran;
  const pending = allTransactions.filter(t => t.status === 'Pending').length;
  const selesai = allTransactions.filter(t => t.status === 'Selesai').length;

  grid.innerHTML = [
    { icon: '💰', value: formatRupiah(penjualan), label: 'Total Penjualan' },
    { icon: '💎', value: formatRupiah(mc), label: 'Total MC' },
    { icon: '🛠️', value: formatRupiah(jasa), label: 'Jasa Admin' },
    { icon: '📥', value: formatRupiah(pemasukan), label: 'Total Pemasukan' },
    { icon: '📤', value: formatRupiah(pengeluaran), label: 'Total Pengeluaran' },
    { icon: '📈', value: formatRupiah(profit), label: 'Total Profit' },
    { icon: '⏳', value: pending, label: 'Pending' },
    { icon: '✅', value: selesai, label: 'Selesai' },
  ].map(s => `
    <div class="stat-card animate-in">
      <div class="stat-icon">${s.icon}</div>
      <div class="stat-value">${s.value}</div>
      <div class="stat-label">${s.label}</div>
    </div>
  `).join('');
}

function renderBulananChart() {
  const ctx = document.getElementById('chartBulanan');
  if (!ctx) return;

  if (charts.bulanan) charts.bulanan.destroy();

  const monthly = {};
  allTransactions.forEach(t => {
    if (t.tanggal && t.status === 'Selesai') {
      const d = t.tanggal.toDate ? t.tanggal.toDate() : new Date(t.tanggal);
      const key = d.toLocaleString('id-ID', { month: 'short', year: 'numeric' });
      const val = parseFloat(t.nominal) || 0;
      if (['Penjualan', 'MC', 'Jasa Admin', 'Pemasukan'].includes(t.kategori)) {
        if (!monthly[key]) monthly[key] = { masuk: 0, keluar: 0 };
        monthly[key].masuk += val;
      } else if (['Pengeluaran', 'Pembelian'].includes(t.kategori)) {
        if (!monthly[key]) monthly[key] = { masuk: 0, keluar: 0 };
        monthly[key].keluar += val;
      }
    }
  });

  const labels = Object.keys(monthly).slice(-6);
  const masukData = labels.map(l => monthly[l].masuk);
  const keluarData = labels.map(l => monthly[l].keluar);

  charts.bulanan = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: labels,
      datasets: [
        { label: 'Pemasukan', data: masukData, backgroundColor: 'rgba(34,197,94,0.5)', borderColor: '#22c55e', borderWidth: 2, borderRadius: 8, borderSkipped: false },
        { label: 'Pengeluaran', data: keluarData, backgroundColor: 'rgba(239,68,68,0.5)', borderColor: '#ef4444', borderWidth: 2, borderRadius: 8, borderSkipped: false }
      ]
    },
    options: {
      responsive: true,
      plugins: { legend: { labels: { color: '#94a3b8' } } },
      scales: {
        x: { ticks: { color: '#94a3b8' }, grid: { color: 'rgba(255,255,255,0.05)' } },
        y: { ticks: { color: '#94a3b8', callback: v => formatRupiah(v) }, grid: { color: 'rgba(255,255,255,0.05)' } }
      }
    }
  });
}

function renderNotes() {
  const list = document.getElementById('notesList');
  const empty = document.getElementById('emptyNotes');
  if (!list) return;

  let notes = [...allTransactions];

  const filterKat = document.getElementById('filterKategori')?.value || '';
  const filterStat = document.getElementById('filterStatusCatatan')?.value || '';

  if (filterKat) notes = notes.filter(n => n.kategori === filterKat);
  if (filterStat) notes = notes.filter(n => n.status === filterStat);

  if (notes.length === 0) {
    list.innerHTML = '';
    if (empty) empty.classList.remove('hidden');
    return;
  }

  if (empty) empty.classList.add('hidden');

  list.innerHTML = notes.map(n => {
    const statusColor = n.status === 'Selesai' ? '#22c55e' : n.status === 'Pending' ? '#f59e0b' : n.status === 'Proses' ? '#3b82f6' : '#ef4444';
    return `
      <div class="note-card animate-in">
        <div class="flex items-center justify-between mb-2">
          <div>
            <strong>${n.judul || 'Tanpa Judul'}</strong>
            <span class="label-badge" style="background:${statusColor}20;color:${statusColor};margin-left:8px;">${n.status || '-'}</span>
          </div>
          <span class="text-sm text-muted">${formatDate(n.tanggal)}</span>
        </div>
        <div class="flex gap-3 text-sm">
          <span>📂 ${n.kategori || '-'}</span>
          ${n.namaCustomer ? `<span>👤 ${n.namaCustomer}</span>` : ''}
          <span style="font-weight:700;color:${parseFloat(n.nominal) >= 0 ? '#22c55e' : '#ef4444'}">${formatRupiah(parseFloat(n.nominal) || 0)}</span>
        </div>
        ${n.catatan ? `<p class="text-sm text-muted mt-2">📝 ${n.catatan}</p>` : ''}
        <div class="flex gap-2 mt-3">
          <button class="btn btn-ghost btn-sm" onclick="editNote('${n.id}')">✏️ Edit</button>
          <button class="btn btn-ghost btn-sm" style="color:#ef4444;" onclick="deleteNote('${n.id}')">🗑️ Hapus</button>
        </div>
      </div>
    `;
  }).join('');
}

function setupNoteListeners() {
  ['filterKategori', 'filterStatusCatatan'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.addEventListener('change', renderNotes);
  });

  const addBtn = document.getElementById('addNoteBtn');
  const emptyBtn = document.getElementById('emptyNoteBtn');
  if (addBtn) addBtn.addEventListener('click', () => openNoteModal());
  if (emptyBtn) emptyBtn.addEventListener('click', () => openNoteModal());

  const modal = document.getElementById('noteModal');
  const closeBtn = document.getElementById('closeNoteModal');
  const cancelBtn = document.getElementById('cancelNoteModal');
  const saveBtn = document.getElementById('saveNote');

  if (closeBtn) closeBtn.addEventListener('click', () => modal.classList.add('hidden'));
  if (cancelBtn) cancelBtn.addEventListener('click', () => modal.classList.add('hidden'));
  if (saveBtn) saveBtn.addEventListener('click', saveNote);
  if (modal) modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });

  // Export
  const exportBtn = document.getElementById('exportBtn');
  if (exportBtn) exportBtn.addEventListener('click', exportCSV);

  // Import
  const importBtn = document.getElementById('importBtn');
  const importFile = document.getElementById('importFileInput');
  if (importBtn && importFile) {
    importBtn.addEventListener('click', () => importFile.click());
    importFile.addEventListener('change', importCSV);
  }
}

