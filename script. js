// --- Export CSV ---
function exportCSV() {
  if (allTransactions.length === 0) {
    showToast('Tidak ada data untuk diexport', 'warning');
    return;
  }
  let csv = 'Judul,Kategori,Nama Customer,Nominal,Status,Tanggal,Catatan\n';
  allTransactions.forEach(t => {
    csv += `"${t.judul || ''}","${t.kategori || ''}","${t.namaCustomer || ''}",${t.nominal || 0},"${t.status || ''}","${formatDate(t.tanggal)}","${t.catatan || ''}"\n`;
  });
  const blob = new Blob([csv], { type: 'text/csv' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `catatan_ndraasturr_${new Date().toISOString().split('T')[0]}.csv`;
  a.click();
  URL.revokeObjectURL(url);
  showToast('Export CSV berhasil!');
}

// --- Import CSV ---
async function importCSV(e) {
  const file = e.target.files[0];
  if (!file) return;

  const reader = new FileReader();
  reader.onload = async function(ev) {
    const text = ev.target.result;
    const lines = text.split('\n').filter(l => l.trim());
    if (lines.length < 2) { showToast('File kosong', 'error'); return; }

    const headers = lines[0].split(',');
    let imported = 0;

    for (let i = 1; i < lines.length; i++) {
      const vals = parseCSVLine(lines[i]);
      if (vals.length < 4) continue;

      const data = {
        judul: vals[0]?.replace(/^"|"$/g, '') || '',
        kategori: vals[1]?.replace(/^"|"$/g, '') || 'Lainnya',
        namaCustomer: vals[2]?.replace(/^"|"$/g, '') || '',
        nominal: parseFloat(vals[3]) || 0,
        status: vals[4]?.replace(/^"|"$/g, '') || 'Pending',
        tanggal: vals[5] ? firebase.firestore.Timestamp.fromDate(new Date(vals[5].replace(/^"|"$/g, ''))) : null,
        catatan: vals[6]?.replace(/^"|"$/g, '') || '',
        createdAt: firebase.firestore.FieldValue.serverTimestamp()
      };

      await db.collection('users').doc(currentUser.uid).collection('transactions').add(data);
      imported++;
    }

    showToast(`${imported} catatan berhasil diimport! 🎉`);
    await loadNotesPage();
  };
  reader.readAsText(file);
  e.target.value = '';
}

function parseCSVLine(line) {
  const result = [];
  let current = '';
  let inQuotes = false;
  for (let char of line) {
    if (char === '"') { inQuotes = !inQuotes; }
    else if (char === ',' && !inQuotes) { result.push(current); current = ''; }
    else { current += char; }
  }
  result.push(current);
  return result;
}

// --- Backup ---
async function backupData() {
  if (!currentUser) return;
  const uid = currentUser.uid;

  try {
    const accSnap = await db.collection('users').doc(uid).collection('accounts').get();
    const transSnap = await db.collection('users').doc(uid).collection('transactions').get();

    const backup = {
      version: '1.0',
      exportedAt: new Date().toISOString(),
      accounts: accSnap.docs.map(d => ({ id: d.id, ...d.data() })),
      transactions: transSnap.docs.map(d => ({ id: d.id, ...d.data() }))
    };

    const blob = new Blob([JSON.stringify(backup, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `backup_ndraasturr_${new Date().toISOString().split('T')[0]}.json`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('Backup berhasil didownload! 💾');

    // Also save to Firestore
    await db.collection('users').doc(uid).collection('settings').doc('backup').set({
      lastBackup: firebase.firestore.FieldValue.serverTimestamp(),
      data: JSON.stringify(backup)
    }, { merge: true });

  } catch (err) {
    console.error('Backup error:', err);
    showToast('Gagal backup', 'error');
  }
}

